FROM node:24-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/admin/package.json apps/admin/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/chat-core/package.json packages/chat-core/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/icons/package.json packages/icons/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN npm ci

FROM deps AS build

ARG ADMIN_BASE_PATH=/admin
ARG NEXT_PUBLIC_API_BASE_URL=https://chat.vpsttt.com
ARG NEXT_PUBLIC_APP_NAME=VPSTTT Chat
ARG NEXT_PUBLIC_WS_BASE_URL=wss://chat.vpsttt.com/ws
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ARG NEXT_PUBLIC_RTC_ICE_SERVERS=stun:stun.l.google.com:19302
ARG NEXT_PUBLIC_TERMS_URL
ARG NEXT_PUBLIC_PRIVACY_URL
ARG NEXT_PUBLIC_TERMS_VERSION
ARG NEXT_PUBLIC_PRIVACY_VERSION
ENV ADMIN_BASE_PATH=$ADMIN_BASE_PATH
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_WS_BASE_URL=$NEXT_PUBLIC_WS_BASE_URL
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_RTC_ICE_SERVERS=$NEXT_PUBLIC_RTC_ICE_SERVERS
ENV NEXT_PUBLIC_TERMS_URL=$NEXT_PUBLIC_TERMS_URL
ENV NEXT_PUBLIC_PRIVACY_URL=$NEXT_PUBLIC_PRIVACY_URL
ENV NEXT_PUBLIC_TERMS_VERSION=$NEXT_PUBLIC_TERMS_VERSION
ENV NEXT_PUBLIC_PRIVACY_VERSION=$NEXT_PUBLIC_PRIVACY_VERSION

COPY . .
RUN npm run build:admin

FROM node:24-alpine AS runner

WORKDIR /app
ARG ADMIN_BASE_PATH=/admin
ARG NEXT_PUBLIC_API_BASE_URL=https://chat.vpsttt.com
ARG NEXT_PUBLIC_APP_NAME=VPSTTT Chat
ARG NEXT_PUBLIC_WS_BASE_URL=wss://chat.vpsttt.com/ws
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ARG NEXT_PUBLIC_RTC_ICE_SERVERS=stun:stun.l.google.com:19302
ARG NEXT_PUBLIC_TERMS_URL
ARG NEXT_PUBLIC_PRIVACY_URL
ARG NEXT_PUBLIC_TERMS_VERSION
ARG NEXT_PUBLIC_PRIVACY_VERSION
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV ADMIN_BASE_PATH=$ADMIN_BASE_PATH
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_WS_BASE_URL=$NEXT_PUBLIC_WS_BASE_URL
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_RTC_ICE_SERVERS=$NEXT_PUBLIC_RTC_ICE_SERVERS
ENV NEXT_PUBLIC_TERMS_URL=$NEXT_PUBLIC_TERMS_URL
ENV NEXT_PUBLIC_PRIVACY_URL=$NEXT_PUBLIC_PRIVACY_URL
ENV NEXT_PUBLIC_TERMS_VERSION=$NEXT_PUBLIC_TERMS_VERSION
ENV NEXT_PUBLIC_PRIVACY_VERSION=$NEXT_PUBLIC_PRIVACY_VERSION
ENV PORT=3001

COPY --from=build /app ./

EXPOSE 3001

CMD ["npm", "--workspace", "@webtui/admin", "run", "start"]
