# Local development
APP_ENV=dev
APP_NAME=webtui-chat
APP_URL=http://localhost:8080
APP_VERSION=dev
SERVICE_NAME=api
LOG_LEVEL=info
LOG_FORMAT=text
TERMS_VERSION=2026-08-07
PRIVACY_POLICY_VERSION=2026-08-07
NEXT_PUBLIC_TERMS_URL=https://download.vpsttt.com/terms
NEXT_PUBLIC_PRIVACY_URL=https://download.vpsttt.com/privacy
NEXT_PUBLIC_TERMS_VERSION=2026-08-07
NEXT_PUBLIC_PRIVACY_VERSION=2026-08-07

# Client release metadata
DESKTOP_MIN_VERSION=0.1.0
DESKTOP_RECOMMENDED_VERSION=dev
DESKTOP_RELEASE_MANIFEST_DIR=
DESKTOP_UPDATE_URL=https://download.vpsttt.com/desktop
MOBILE_MIN_VERSION=0.1.0
MOBILE_RECOMMENDED_VERSION=dev
MOBILE_RELEASE_MANIFEST_DIR=
MOBILE_DOWNLOAD_URL=https://download.vpsttt.com/mobile
MOBILE_STORE_URL=
DOWNLOAD_MANIFEST_DIR=

# HTTP
API_HTTP_HOST=0.0.0.0
API_HTTP_PORT=8080
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=60s
API_SHUTDOWN_TIMEOUT=10s

# Reverse proxy, CORS, hardening, metrics
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
SECURE_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=60
METRICS_ENABLED=true
METRICS_PATH=/metrics
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACE_SAMPLE_RATIO=0.10

# Worker
WORKER_CONCURRENCY=4
# Must match the public security/moderation evidence retention statement.
MODERATION_EVIDENCE_RETENTION_DAYS=365
MODULE_RUNNER_SCRIPT_ALLOWLIST=

# Backup
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_TIMEOUT=10m

# PostgreSQL local
DATABASE_ENABLED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=webtui_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DATABASE_URL=postgres://postgres:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5432/webtui_chat?sslmode=disable

# Redis local
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# RabbitMQ local
RABBITMQ_ENABLED=false
RABBITMQ_DEFAULT_USER=webtui
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://webtui:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/

# Storage local/minio
STORAGE_PROVIDER=minio
LOCAL_STORAGE_PATH=data/storage
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=webtui-chat
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY

# Security
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_REFRESH_SECRET
WEBHOOK_SIGNING_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET
# AES-GCM master key for per-host S3 credentials. Back it up and do not rotate
# without re-encrypting saved credentials. Falls back to WEBHOOK_SIGNING_SECRET.
STORAGE_CREDENTIALS_KEY=CHANGE_ME_RANDOM_STORAGE_CREDENTIALS_KEY

# New accounts are automatically enrolled as workspace_member. Leave empty
# only for single-workspace installations; set explicitly when multiple active
# workspaces exist.
REGISTRATION_DEFAULT_WORKSPACE_ID=

# VPSTTT order API for internal customer-care bots
ORDER_API_BASE_URL=https://order.vpsttt.com/api
# Internal X-API-Key used by /api/internal/* endpoints. Do not use an ovw_ Overview key here.
ORDER_INTERNAL_API_KEY=
ORDER_QUICK_ORDER_KEY=
ORDER_API_TIMEOUT=10s

# Docker image production
WEBTUI_API_IMAGE=ghcr.io/owner/repo/api:latest
WEBTUI_WORKER_IMAGE=ghcr.io/owner/repo/worker:latest
WEBTUI_WEB_IMAGE=ghcr.io/owner/repo/web:latest
WEBTUI_ADMIN_IMAGE=ghcr.io/owner/repo/admin:latest
DEPLOYMENT_MODE=self_hosted
INSTANCE_DOMAIN=chat.vpsttt.com
INSTANCE_NAME=WebTUI Chat
PORTAL_ORIGIN=https://download.vpsttt.com
PORTAL_DOMAIN=download.vpsttt.com
WEBTUI_APP_LINK_HOST=chat.vpsttt.com
API_DOMAIN=chat.vpsttt.com
FRONTEND_DOMAIN=chat.vpsttt.com
NEXT_PUBLIC_API_BASE_URL=https://chat.vpsttt.com
NEXT_PUBLIC_WS_BASE_URL=wss://chat.vpsttt.com/ws
