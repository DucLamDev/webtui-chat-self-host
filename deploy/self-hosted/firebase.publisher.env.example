# Merge these lines into deploy/self-hosted/.env only on the publisher VPS
# that runs the official push-relay profile. Ordinary customer instances use
# PUSH_RELAY_URL/TOKEN/INSTANCE_ID and leave all FIREBASE_* values empty.

# Exact public Firebase project from the official Android app.
FIREBASE_PROJECT_ID=webtui-chat

# Base Compose does not mount a credential file into the relay container.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Generate this secret from the downloaded FCM service-account JSON:
# [Convert]::ToBase64String([IO.File]::ReadAllBytes('C:\secure\firebase-service-account.json'))
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=REPLACE_WITH_BASE64_SERVICE_ACCOUNT_JSON

# Informational client identifiers. They are compiled into the official AAB;
# backend code does not read these three variables.
# FIREBASE_MESSAGING_SENDER_ID=595077870179
# FIREBASE_ANDROID_APP_ID=1:595077870179:android:a6f4ff5cc14a0d1485be56
# FIREBASE_ANDROID_PACKAGE=com.vpsttt.webtui_chat
