DEPLOYMENT_MODE=self_hosted
INSTANCE_DOMAIN=chat.example.com
INSTANCE_NAME=Example Chat
APP_ENV=production
APP_NAME=Example Chat
APP_URL=https://chat.example.com
APP_VERSION=self-hosted
LOG_LEVEL=info
LOG_FORMAT=json

API_HTTP_HOST=0.0.0.0
API_HTTP_PORT=8080
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
PORTAL_ORIGIN=https://chat.vpsttt.com
CORS_ALLOWED_ORIGINS=https://chat.example.com,https://chat.vpsttt.com,http://tauri.localhost,https://tauri.localhost,tauri://localhost
SECURE_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=60
METRICS_ENABLED=true
METRICS_PATH=/metrics

DATABASE_ENABLED=true
POSTGRES_DB=vpsttt_chat
POSTGRES_USER=vpsttt
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://vpsttt:CHANGE_ME@postgres:5432/vpsttt_chat?sslmode=disable

REDIS_ENABLED=true
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

RABBITMQ_ENABLED=true
RABBITMQ_USER=vpsttt
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_URL=amqp://vpsttt:CHANGE_ME@rabbitmq:5672/

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/var/lib/vpsttt-chat/storage
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_TIMEOUT=30m

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
WEBHOOK_SIGNING_SECRET=CHANGE_ME
OIDC_STATE_SECRET=CHANGE_ME
OIDC_CLIENT_SECRETS=

GOOGLE_CLIENT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

ORDER_API_BASE_URL=
ORDER_INTERNAL_API_KEY=
ORDER_QUICK_ORDER_KEY=
MODULE_RUNNER_SCRIPT_ALLOWLIST=

CALL_RING_TIMEOUT=30s
TURN_EXTERNAL_IP=203.0.113.10
TURN_USERNAME=vpsttt-turn
TURN_PASSWORD=CHANGE_ME
NEXT_PUBLIC_RTC_ICE_SERVERS=[{"urls":"stun:chat.example.com:3478"},{"urls":"turn:chat.example.com:3478?transport=udp","username":"vpsttt-turn","credential":"CHANGE_ME"},{"urls":"turn:chat.example.com:3478?transport=tcp","username":"vpsttt-turn","credential":"CHANGE_ME"}]
RTC_ICE_SERVERS=[{"urls":"stun:chat.example.com:3478"},{"urls":"turn:chat.example.com:3478?transport=udp","username":"vpsttt-turn","credential":"CHANGE_ME"},{"urls":"turn:chat.example.com:3478?transport=tcp","username":"vpsttt-turn","credential":"CHANGE_ME"}]

LETSENCRYPT_EMAIL=admin@example.com
WORKER_CONCURRENCY=4
