DEPLOYMENT_MODE=self_hosted
INSTANCE_DOMAIN=chat.example.com
INSTANCE_NAME=Example Chat
INSTANCE_LOGO_URL=https://chat.example.com/branding/logo.png
INSTANCE_REGISTRATION_MODE=open
APP_ENV=production
APP_NAME=Example Chat
APP_URL=https://chat.example.com
APP_VERSION=self-hosted
MOBILE_MIN_VERSION=1.0.0
LOG_LEVEL=info
LOG_FORMAT=json
TERMS_VERSION=2026-08-07
PRIVACY_POLICY_VERSION=2026-08-07
NEXT_PUBLIC_TERMS_URL=https://download.webtui.vn/terms
NEXT_PUBLIC_PRIVACY_URL=https://download.webtui.vn/privacy
NEXT_PUBLIC_TERMS_VERSION=2026-08-07
NEXT_PUBLIC_PRIVACY_VERSION=2026-08-07

API_HTTP_HOST=0.0.0.0
API_HTTP_PORT=8080
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
PORTAL_ORIGIN=https://download.webtui.vn
PORTAL_DOMAIN=download.webtui.vn
# The official universal mobile app declares only the publisher-controlled host.
# Customer instance domains are entered manually in the app and must not pretend
# to be verified App Links for the publisher-signed binary.
WEBTUI_APP_LINK_HOST=chat.vpsttt.com
# Set true only when operating a separately signed custom-branded mobile app.
PRESERVE_CUSTOM_APP_LINK_HOST=false
# Play-only default: the publisher portal deliberately returns 404 for AASA.
# Set true only after the matching signed iOS app and portal association exist.
ENABLE_IOS_ASSOCIATION=false
DESKTOP_DOWNLOAD_URL=https://download.webtui.vn/download/
MOBILE_DOWNLOAD_URL=https://download.webtui.vn/download/
DOCUMENTATION_URL=https://download.webtui.vn/#self-host
CORS_ALLOWED_ORIGINS=https://chat.example.com,https://chat.example.com:8444,https://download.webtui.vn,http://tauri.localhost,https://tauri.localhost,tauri://localhost
SECURE_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=60
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Optional OpenTelemetry/Grafana stack (Compose profile: observability). Traces
# are disabled unless explicitly enabled, so the normal stack has no collector
# dependency. Keep Grafana bound to loopback unless it is protected by SSO.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACE_SAMPLE_RATIO=0.10
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_RANDOM_GRAFANA_PASSWORD
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3300

DATABASE_ENABLED=true
POSTGRES_DB=vpsttt_chat
POSTGRES_USER=vpsttt
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://vpsttt:CHANGE_ME@postgres:5432/vpsttt_chat?sslmode=disable

REDIS_ENABLED=true
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

RABBITMQ_ENABLED=true
RABBITMQ_USER=vpsttt
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_URL=amqp://vpsttt:CHANGE_ME@rabbitmq:5672/

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/var/lib/vpsttt-chat/storage
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_TIMEOUT=30m

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
WEBHOOK_SIGNING_SECRET=CHANGE_ME
# Dedicated AES-GCM key for S3/MinIO credentials saved in the host settings.
# Back this value up; changing it makes existing encrypted credentials unreadable.
STORAGE_CREDENTIALS_KEY=CHANGE_ME
BOT_AI_SECRET_KEY=CHANGE_ME
OIDC_STATE_SECRET=CHANGE_ME
OIDC_CLIENT_SECRETS=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.vpsttt.webtuiChat
APNS_PRIVATE_KEY_FILE=
APNS_PRIVATE_KEY_BASE64=
APNS_SANDBOX=false
# Recommended for the official iOS/Android binary: use the publisher relay so
# this instance does not need the mobile app's FCM/APNs signing credentials.
# Direct FIREBASE_*/APNS_* delivery remains available for custom-branded apps.
# Leave all three values empty until the publisher has issued a strong token.
# PUSH_RELAY_INSTANCE_ID must equal discovery.instance_id (the immutable zone.id
# UUID) in canonical lowercase form. The publisher map key must be exactly the
# same UUID; never use a slug/domain alias.
PUSH_RELAY_URL=
PUSH_RELAY_TOKEN=
PUSH_RELAY_INSTANCE_ID=

# Per-instance Web Push. Generate one key pair once, back it up with .env, then
# set WEB_PUSH_ENABLED=true. Rotating keys invalidates existing subscriptions.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_TTL_SECONDS=300
WEB_PUSH_MAX_SUBSCRIPTIONS_PER_USER=10

# Optional publisher-operated relay service (`docker compose --profile
# push-relay up -d`). This is for an operator who owns the official mobile
# FCM/APNs credentials; ordinary customer instances leave it disabled. Compose
# maps only the relay allowlist from this file; the relay never receives the
# unrelated JWT/webhook/bot/OIDC/TURN/storage application secrets.
PUSH_RELAY_SERVER_ENABLED=false
PUSH_RELAY_HTTP_HOST=0.0.0.0
# Bundled Caddy and Prometheus use the invariant internal port 8090. Do not
# change it here; a dedicated relay ingress/deployment may choose another port.
PUSH_RELAY_HTTP_PORT=8090
# Semicolon-delimited <discovery-zone-uuid>=<strong-token> entries. Use the exact
# UUID injected as instance_id in deliveries, plus a unique 32+ character token.
PUSH_RELAY_PUBLISHERS=
PUSH_RELAY_MAX_BODY_BYTES=32768
PUSH_RELAY_RATE_LIMIT_PER_MINUTE=240
PUSH_RELAY_RATE_LIMIT_BURST=60
PUSH_RELAY_WORKER_CONCURRENCY=4
PUSH_RELAY_POLL_INTERVAL=1s

ORDER_API_BASE_URL=
ORDER_INTERNAL_API_KEY=
ORDER_QUICK_ORDER_KEY=
MODULE_RUNNER_SCRIPT_ALLOWLIST=
TALK_AI_ALLOWED_HOSTS=ollama,local-ai
BOT_AI_ALLOWED_HOSTS=ollama,local-ai
# Có thể nhập API key trực tiếp trong giao diện; backend mã hóa bằng BOT_AI_SECRET_KEY.
# Hoặc dùng secret_ref=env://BOT_AI_OPENAI_KEY:
# BOT_AI_OPENAI_KEY=

CALL_RING_TIMEOUT=30s
TURN_EXTERNAL_IP=203.0.113.10
TURN_SHARED_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp
TURN_CREDENTIAL_TTL=10m
NEXT_PUBLIC_RTC_ICE_SERVERS=[{"urls":"stun:chat.example.com:3478"}]
# Group calls use the Jitsi containers bundled with this Compose stack. The
# installer fills these from INSTANCE_DOMAIN and creates the internal secrets.
NEXT_PUBLIC_JITSI_BASE_URL=https://chat.example.com:8443
JITSI_BASE_URL=https://chat.example.com:8443
JICOFO_AUTH_PASSWORD=CHANGE_ME
JVB_AUTH_PASSWORD=CHANGE_ME
RTC_ICE_SERVERS=[{"urls":"stun:chat.example.com:3478"}]

# Free internal document editing through ONLYOFFICE Docs Community.
ONLYOFFICE_ENABLED=false
ONLYOFFICE_PUBLIC_URL=https://chat.example.com:8444
ONLYOFFICE_INTERNAL_URL=http://onlyoffice-document-server
ONLYOFFICE_API_INTERNAL_URL=https://chat.example.com
ONLYOFFICE_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
ONLYOFFICE_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
ONLYOFFICE_IMAGE_VERSION=latest

LETSENCRYPT_EMAIL=admin@example.com
WORKER_CONCURRENCY=4
# Align this with SECURITY_LOG_RETENTION_DAYS on the public policy portal.
MODERATION_EVIDENCE_RETENTION_DAYS=365
